.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	${RM} $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CC) $(LINKOBJ) -o $(BIN) $(LIBS)

alquileres.o: alquileres.c
	$(CC) -c alquileres.c -o alquileres.o $(CFLAGS)

clientes.o: clientes.c
